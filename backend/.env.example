PORT=5000
FRONTEND_URL=http://localhost:5173

# yt-dlp / ffmpeg binaries (must be installed on the host / docker image)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Downloads
DOWNLOADS_DIR=downloads
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5
MAX_CONCURRENT_DOWNLOADS=2

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

YTDLP_PATH=./yt-dlp
FFMPEG_PATH=./ffmpeg